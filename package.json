{
  "name": "joplin-plugin-journey-tasks",
  "version": "0.1.1",
  "description": "Joplin task agenda with recurring and lunar tasks",
  "license": "MIT",
  "keywords": [
    "joplin-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "build": "node scripts/build.mjs",
    "dist": "npm run typecheck && npm run build",
    "check": "npm run typecheck && npm run verify:exports && npm test && npm run build && npm run verify:package",
    "verify:exports": "node scripts/check-unused-exports.mjs",
    "verify:package": "node --import tsx --test tests/package-smoke.test.ts",
    "prepack": "npm run build",
    "verify:release": "node scripts/verify-release.mjs",
    "prepublishOnly": "npm run build && npm run check && npm run verify:release"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-test-renderer": "^19.3.0",
    "esbuild": "0.28.2",
    "react-test-renderer": "^19.2.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigerwoo/journey-tasks-joplin-desktop.git"
  },
  "homepage": "https://github.com/tigerwoo/journey-tasks-joplin-desktop",
  "bugs": {
    "url": "https://github.com/tigerwoo/journey-tasks-joplin-desktop/issues"
  },
  "files": [
    "publish/io.journey.tasks.97d1cd8a-5ed4-4cc9-9bf8-f0b287db6cad.jpl",
    "publish/io.journey.tasks.97d1cd8a-5ed4-4cc9-9bf8-f0b287db6cad.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
